{
  "name": "emir-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "check": "vue-tsc --noEmit",
    "build": "npm run check && vite build && vite build --ssr src/prerender-entry.ts --outDir .ssr-build && node scripts/prerender.mjs",
    "preview": "node scripts/serve.mjs",
    "test": "npm run test:unit && playwright test",
    "test:report": "playwright show-report",
    "size": "node scripts/size-report.mjs",
    "test:unit": "node --test tests/unit/*.test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "1.64.1",
    "@vitejs/plugin-vue": "6.0.10",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vue-tsc": "3.3.14"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  }
}
